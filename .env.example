# Copy this file to .env and fill in your keys. Never commit .env.
# API keys MUST be here (never in settings.yaml). Every other setting has a default in
# config/settings.yaml; a line here overrides it (precedence: settings.yaml < .env < environment).

# Brain (LLM)
SARVAM_API_KEY=sk_your_key_here

# Speech (ADR 0009): Deepgram speech-to-text, Cartesia text-to-speech
DEEPGRAM_API_KEY=                   # https://console.deepgram.com
CARTESIA_API_KEY=                   # https://play.cartesia.ai (starts with sk_car_)
CARTESIA_VOICE_ID=                  # pick one: python tools/try_cartesia.py --list-voices
# STT_PROVIDER=deepgram             # deepgram | sarvam
# TTS_PROVIDER=cartesia             # cartesia | sarvam
# DEEPGRAM_LANGUAGE=hi              # live streaming: hi | multi | en
# DEEPGRAM_KEYTERMS=Arijit Singh, Lata Mangeshkar   # extra names to hear better; none = off

# --- Optional overrides (uncomment to change) ---------------------------------
# Models (see docs/sarvam_api_notes.md)
# SARVAM_LLM_MODEL=sarvam-105b
# SARVAM_LLM_REASONING=low          # low | medium | high | max | none (fastest)
# LLM_TIMEOUT_S=12

# Audio
# MIC_DEVICE=                       # empty = default mic; or a device index / name
# SPEAKER_DEVICE=                   # empty = default speaker
# NOISE_GATE=0.0
# BARGE_IN=false

# Speech-to-text
# LANGUAGE_HINT=                    # empty = auto-detect; e.g. hi-IN
# WAKE_WORD=                        # empty = off; e.g. sarvam
# VAD_SILENCE_MS=800                # pause (ms) that ends a sentence; 500 cut natural mid-sentence pauses
# LOCAL_SILENCE_MS=900
# STT_FALLBACK_AFTER=3

# Brain
# HISTORY_TURNS=4
# DEFAULT_LANGUAGE=hi-IN
# FILLER_AFTER_MS=1200
# MAX_TURN_S=20

# Text-to-speech
# TTS_SPEAKER=priya
# TTS_VOICES=hi-IN:priya,ta-IN:kavitha,te-IN:kavya
# TTS_PACE=1.0

# Safety
# CONFIRM_TIMEOUT_S=10
# MAX_ACTIONS_PER_MINUTE=10
# SHUTDOWN_DELAY_S=60
# ACTION_TIMEOUT_S=5
# STOP_WORDS_ENABLED=true

# UI
# UI_FONT_SIZE=20
# UI_THEME=dark                     # dark | light | high_contrast
# UI_LANGUAGE=en                    # en | hi

# Paths (relative paths are inside the project folder)
# DB_PATH=data/assistant.db
# LOG_DIR=logs
# NOTES_DIR=                        # empty = Documents\Sarvam Assistant
