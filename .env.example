# Copy this file to .env and fill in your key. Never commit .env.
SARVAM_API_KEY=sk_your_key_here

# Models (see docs/sarvam_api_notes.md)
SARVAM_STT_REALTIME_MODEL=saaras:v3-realtime
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
# low | medium | high | max | none  (none turns thinking off = fastest)
SARVAM_LLM_REASONING=low
SARVAM_TTS_MODEL=bulbul:v3

# Voice
TTS_SPEAKER=priya
TTS_SAMPLE_RATE=24000
TTS_PACE=1.0
DEFAULT_LANGUAGE=hi-IN

# Audio input
SAMPLE_RATE=16000
CHUNK_MS=100
VAD_SILENCE_MS=500
# Leave empty for the default microphone, or put a device index or name.
MIC_DEVICE=

# Behaviour
HISTORY_TURNS=10
# Empty = wake word off. Example: sarvam
WAKE_WORD=
CONFIRM_TIMEOUT_S=6
SHUTDOWN_DELAY_S=60
MAX_ACTIONS_PER_MINUTE=10
BARGE_IN=false

# Paths (relative paths are inside the project folder)
DB_PATH=data/assistant.db
LOG_DIR=logs
# Empty = Documents\Sarvam Assistant
NOTES_DIR=
