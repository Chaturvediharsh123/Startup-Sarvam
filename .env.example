# Copy this file to .env and fill in your key. Never commit .env.
# Only the API key MUST be here. Every other setting has a default in
# config/settings.yaml; a line here overrides it (precedence: settings.yaml < .env < environment).
SARVAM_API_KEY=sk_your_key_here

# --- Optional overrides (uncomment to change) ---------------------------------
# Models (see docs/sarvam_api_notes.md)
# SARVAM_LLM_MODEL=sarvam-105b
# SARVAM_LLM_REASONING=low          # low | medium | high | max | none (fastest)
# LLM_TIMEOUT_S=12

# Audio
# MIC_DEVICE=                       # empty = default mic; or a device index / name
# SPEAKER_DEVICE=                   # empty = default speaker
# NOISE_GATE=0.0
# BARGE_IN=false

# Speech-to-text
# LANGUAGE_HINT=                    # empty = auto-detect; e.g. hi-IN
# WAKE_WORD=                        # empty = off; e.g. sarvam
# VAD_SILENCE_MS=500
# LOCAL_SILENCE_MS=900
# STT_FALLBACK_AFTER=3

# Brain
# HISTORY_TURNS=4
# DEFAULT_LANGUAGE=hi-IN
# FILLER_AFTER_MS=1200
# MAX_TURN_S=20

# Text-to-speech
# TTS_SPEAKER=priya
# TTS_VOICES=hi-IN:priya,ta-IN:kavitha,te-IN:kavya
# TTS_PACE=1.0

# Safety
# CONFIRM_TIMEOUT_S=10
# MAX_ACTIONS_PER_MINUTE=10
# SHUTDOWN_DELAY_S=60
# ACTION_TIMEOUT_S=5
# STOP_WORDS_ENABLED=true

# UI
# UI_FONT_SIZE=20
# UI_THEME=dark                     # dark | light | high_contrast
# UI_LANGUAGE=en                    # en | hi

# Paths (relative paths are inside the project folder)
# DB_PATH=data/assistant.db
# LOG_DIR=logs
# NOTES_DIR=                        # empty = Documents\Sarvam Assistant
