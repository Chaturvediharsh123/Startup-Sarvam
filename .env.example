# Copy to .env and adjust. Never commit .env.

# ---------- Action Block ----------
ACTIONS_DEFAULT_TIMEOUT_S=30
ACTIONS_MAX_TIMEOUT_S=120
ACTIONS_EVIDENCE_DIR=.data/evidence
ACTIONS_DOWNLOAD_DIR=.data/downloads
ACTIONS_SCREENSHOT_ON_FAILURE=true
ACTIONS_VISUAL_EVIDENCE=true

ACTIONS_BROWSER_HEADLESS=false
# chromium (bundled), chrome or msedge
ACTIONS_BROWSER_CHANNEL=chrome
# Persistent profile keeps logins between runs. Leave empty for a throwaway profile.
ACTIONS_BROWSER_USER_DATA_DIR=.data/browser-profile

# OCR for screen targets given as text: auto = Tesseract if installed, else Windows OCR (English only).
# Install Tesseract with Hindi data for Devanagari, or point to it explicitly.
ACTIONS_OCR_ENGINE=auto
ACTIONS_OCR_LANGUAGES=["en", "hi"]
# ACTIONS_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Applications open_app/close_app may touch (JSON). Anything else is refused.
# ACTIONS_APPS={"notepad": {"command": ["notepad.exe"], "window_title_re": ".*Notepad.*"}}

# Capabilities to switch off entirely (JSON list)
# ACTIONS_DISABLED_CAPABILITIES=["download"]

# ---------- Memory Block ----------
MEMORY_DB_PATH=.data/memory/memory.sqlite3
MEMORY_LANCEDB_PATH=.data/memory/lancedb
MEMORY_SEMANTIC_ENABLED=true
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_CACHE_DIR=~/.cache/sarvam-memory/models
MEMORY_STALE_AFTER_DAYS=90
MEMORY_WORKFLOW_STALE_AFTER_DAYS=30

# Retrieval thresholds/weights (tuned with: python -m memory.evaluation tests/memory/data/retrieval_eval.json --tune)
MEMORY_MIN_RELEVANCE=0.2
MEMORY_SEMANTIC_MIN_SIMILARITY=0.3
# MEMORY_RANKING={"agreement_bonus": 0.25, "confidence_weight": 0.5}

# Opt-in search log for tuning on real usage (queries are redacted). Local only, never commit.
# MEMORY_RETRIEVAL_LOG_PATH=.data/retrieval_log.jsonl
